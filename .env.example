# ShieldScan v2.0 — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── Required for AI Copilot ─────────────────────────────────────────
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here...

# ── Optional: choose model (default: gpt-4o-mini) ───────────────────
# gpt-4o-mini  — fast, cheap, good quality  (recommended)
# gpt-4o       — best quality, higher cost
# gpt-3.5-turbo — cheapest option
COPILOT_MODEL=gpt-4o-mini

# ── Flask server settings ───────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-string-in-production
DEBUG=true
PORT=5000

# ── Notes ───────────────────────────────────────────────────────────
# If OPENAI_API_KEY is not set, the copilot will still work using
# a built-in rule-based fallback — no AI calls, but useful responses
# based directly on your scan data.
